      <children xsi:type="cad:Assembly" name="BrakeByWire" label="BrakeByWire">
        <children xsi:type="cad:Box" name="BrakeByWirePart" label="BrakeByWirePart" length="0.1" width="0.05" height="0.02" material="//@materials.0"/>
      </children>
      <children xsi:type="cad:Assembly" name="FrontBrakeDisc" label="FrontBrakeDisc">
        <children xsi:type="cad:Cylinder" name="FrontBrakeDiscBody" label="FrontBrakeDiscBody" radius="0.11" height="0.004" material="//@materials.0"/>
      </children>
      <children xsi:type="cad:Assembly" name="FrontBrakeCaliper" label="FrontBrakeCaliper">
        <children xsi:type="cad:Box" name="FrontCaliperBody" label="FrontCaliperBody" length="0.12" width="0.04" height="0.05" material="//@materials.1"/>
