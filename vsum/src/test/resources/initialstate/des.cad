        <children xsi:type="cad:Box" name="FrontCaliperMountingBracket" label="FrontCaliperMountingBracket" length="0.08" width="0.03" height="0.008" material="//@materials.1"/>
        <children xsi:type="cad:Box" name="FrontBrakePads" label="FrontBrakePads" length="0.05" width="0.04" height="0.008" material="//@materials.4"/>
      </children>
      <children xsi:type="cad:Assembly" name="RearBrakeDisc" label="RearBrakeDisc">
        <children xsi:type="cad:Cylinder" name="RearBrakeDiscBody" label="RearBrakeDiscBody" radius="0.1" height="0.004" material="//@materials.0"/>
      </children>
      <children xsi:type="cad:Assembly" name="RearBrakeCaliper" label="RearBrakeCaliper">
        <children xsi:type="cad:Box" name="RearCaliperBody" label="RearCaliperBody" length="0.12" width="0.04" height="0.05" material="//@materials.1"/>
        <children xsi:type="cad:Cylinder" name="RearCaliperPiston" label="RearCaliperPiston" radius="0.011" height="0.02" material="//@materials.3"/>
        <children xsi:type="cad:Box" name="RearCaliperMountingBracket" label="RearCaliperMountingBracket" length="0.08" width="0.03" height="0.008" material="//@materials.1"/>
        <children xsi:type="cad:Box" name="RearBrakePads" label="RearBrakePads" length="0.05" width="0.04" height="0.008" material="//@materials.4"/>
      </children>
      <children xsi:type="cad:Cylinder" name="FrontBrakeHose" label="FrontBrakeHose" radius="0.002" height="0.45" material="//@materials.4"/>
    </children>
    <children xsi:type="cad:Assembly" name="BrakeOverTravelSwitch" label="BrakeOverTravelSwitch">
      <children xsi:type="cad:Assembly" name="PushPullSwitch" label="PushPullSwitch">
        <children xsi:type="cad:Box" name="PushPullSwitchPart" label="PushPullSwitchPart" length="0.1" width="0.05" height="0.02" material="//@materials.0"/>
