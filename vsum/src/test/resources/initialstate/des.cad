          <geometries xsi:type="cad:LineSegment">
            <start/>
            <end x="0.1"/>
          </geometries>
          <constraints name="ScatterShieldMinThickness" value="2.0" first="//@objects.3/@children.0/@children.1/@children.0/@geometries.0"/>
