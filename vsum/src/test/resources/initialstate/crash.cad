<?xml version='1.0' encoding='UTF-8'?>
<cad:CADDocument xmlns:xmi="http://www.omg.org/XMI" xmlns:cad="http://demonstrator.kit.edu/cad" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="CRASH" xmi:version="2.0">
  <materials name="Steel" density="7850.0"/>
  <materials name="Aluminium" density="2700.0"/>
  <materials name="CFRP" density="1600.0"/>
  <objects xsi:type="cad:Assembly" name="PrimaryStructure" label="PrimaryStructure">
    <children xsi:type="cad:Assembly" name="CompositeStructures" label="CompositeStructures">
