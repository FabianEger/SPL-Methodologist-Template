      </children>
      <children xsi:type="cad:Assembly" name="MechanicallyAttachedBracing" label="MechanicallyAttachedBracing">
        <children xsi:type="cad:Box" name="LugJoints" label="LugJoints" length="0.1" width="0.05" height="0.02" material="//@materials.0"/>
        <children xsi:type="cad:Box" name="SleeveJoints" label="SleeveJoints" length="0.1" width="0.05" height="0.02" material="//@materials.0"/>
      </children>
    </children>
    <children xsi:type="cad:Assembly" name="FrontBulkhead" label="FrontBulkhead">
