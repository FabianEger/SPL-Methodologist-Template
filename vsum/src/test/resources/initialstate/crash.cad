    </children>
    <children xsi:type="cad:Assembly" name="ImpactStructures" label="ImpactStructures">
      <children xsi:type="cad:Assembly" name="SideImpactStructure" label="SideImpactStructure">
        <children xsi:type="cad:Assembly" name="OtherImpactStructures" label="OtherImpactStructures">
          <children xsi:type="cad:Box" name="OtherImpactStructuresPart" label="OtherImpactStructuresPart" length="0.1" width="0.05" height="0.02" material="//@materials.0"/>
