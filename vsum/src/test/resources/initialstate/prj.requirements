      <requirements name="ANF-085" text="Die Wandstärke der Hülse muss mindestens der der Abstützungsrohre entsprechen" subteam="Monocoque" category="Mechanisch befestigte Überrollbügel-Abstützung" unit="-" priority="Muss" role="CRASH">
        <carValues name="CV1" value="x"/>
