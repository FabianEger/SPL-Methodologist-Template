          <carValues name="CV2" value="x"/>
        </requirements>
        <requirements name="ZIE-062" text="Sicherer und zuverlässiger Betrieb mit Wasserstoff" subteam="Wasserstoff Antriebsstrang" category="-" unit="-" priority="Muss" role="PRJ" kind="Goal">
          <carValues name="CV2" value="x"/>
