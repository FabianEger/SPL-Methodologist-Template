        <carValues name="CV2" value="x"/>
      </requirements>
    </sections>
  </sections>
  <sections name="VehicleConcept" description="Requirements and decisions for VehicleConcept">
    <requirements name="ANF-001" text="Vorgaben für das Fahrzeugkonzept: Open-wheel, einsitzig, offenes Cockpit (Formula Style) und vier Räder nicht in einer Spur" subteam="Gesamtfahrzeug" category="Allgemeines" unit="-" priority="Muss" role="PRJ">
      <carValues name="EV3" value="x"/>
      <carValues name="CV2" value="x"/>
      <carValues name="CV1" value="x"/>
    </requirements>
    <requirements name="ANF-002" text="Sichtbarkeit der Rad-Reifen-Einheit in der Seitenansicht muss vollständig unversperrt sein" subteam="Gesamtfahrzeug" category="Allgemeines" unit="-" priority="Muss" role="PRJ">
      <carValues name="EV3" value="x"/>
      <carValues name="CV2" value="x"/>
      <carValues name="CV1" value="x"/>
    </requirements>
    <requirements name="ANF-241" text="Das Fahrzeug muss sich ohne Person und mit ausgeschaltetem Hauptschalter bewegen lassen" subteam="Gesamtfahrzeug" category="Antrieb allgemein" unit="-" priority="Muss" role="PRJ">
      <carValues name="EV3" value="x"/>
      <carValues name="CV2" value="x"/>
      <carValues name="CV1" value="x"/>
    </requirements>
  </sections>
  <sections name="ProjectGoals" description="Requirements and decisions for ProjectGoals">
    <sections name="MaxVehicleMass" description="Requirements and decisions for MaxVehicleMass">
      <requirements name="ZIE-003" text="Maximales Gewicht" subteam="Gesamtfahrzeug" category="-" unit="kg" priority="Soll" role="PRJ" kind="Goal">
        <carValues name="EV3" value="175"/>
        <carValues name="CV2" value="220"/>
        <carValues name="CV1" value="175"/>
      </requirements>
    </sections>
  </sections>
  <sections name="DomainRequirements" description="Requirements realised by the other stakeholder roles">
    <sections name="AERORequirements" description="Requirements realised by Aerodynamics Engineer">
      <requirements name="ANF-399" text="Maximale kombinierte Gesamtleistung aktiver Luftbewegungsvorrichtungen" subteam="Gesamtfahrzeug" category="Lüfter und Turbinen" unit="W" priority="Muss" role="AERO">
        <carValues name="EV3" value="500"/>
        <carValues name="CV2" value="500"/>
      </requirements>
      <requirements name="FUN-040" text="Die Umgebungsluft aktiv ansaugen oder ausblasen" subteam="Gesamtfahrzeug" category="Lüfter und Turbinen" unit="-" priority="Muss" role="AERO" kind="Function">
        <carValues name="EV3" value="x"/>
        <carValues name="CV2" value="x"/>
      </requirements>
      <requirements name="ANF-271" text="Es darf kein angetriebenes Gerät (wie z. B. ein Lüfter) verwendet werden, um Luft unter dem Fahrzeug zu bewegen oder abzusaugen" subteam="Aerodynamik" category="Bauteilbegrenzung" unit="-" priority="Muss" role="AERO">
        <carValues name="CV1" value="x"/>
      </requirements>
      <requirements name="ZIE-014" text="Zielbereich für die aerodynamische Balance (Center of Pressure), verlagert nach hinten" subteam="Aerodynamik" category="-" unit="%" priority="Soll" role="AERO" kind="Goal">
        <carValues name="EV3" value="55"/>
        <carValues name="CV1" value="65"/>
      </requirements>
      <requirements name="ANF-005" text="Aerodynamische Bauteile dürfen nicht die Fahrbahnoberfläche berühren" subteam="Aerodynamik" category="Fahrzeugmaße" unit="-" priority="Muss" role="AERO">
        <carValues name="EV3" value="x"/>
        <carValues name="CV2" value="x"/>
      </requirements>
      <requirements name="ANF-272" text="Maximale Höhe der aerodynamischen Bauteile (hinter der Kopfstütze)" subteam="Aerodynamik" category="Bauteilbegrenzung" unit="mm" priority="Muss" role="AERO">
        <carValues name="EV3" value="1100"/>
        <carValues name="CV2" value="1100"/>
        <carValues name="CV1" value="1100"/>
      </requirements>
      <requirements name="ANF-273" text="Maximale Höhe der aerodynamischen Bauteile (vor der Kopfstütze)" subteam="Aerodynamik" category="Bauteilbegrenzung" unit="mm" priority="Muss" role="AERO">
        <carValues name="EV3" value="500"/>
        <carValues name="CV2" value="500"/>
        <carValues name="CV1" value="500"/>
      </requirements>
      <requirements name="ANF-274" text="Maximale Höhe der aerodynamischen Bauteile (vor der Vorderachse, außen)" subteam="Aerodynamik" category="Bauteilbegrenzung" unit="mm" priority="Muss" role="AERO">
        <carValues name="EV3" value="250"/>
        <carValues name="CV2" value="250"/>
        <carValues name="CV1" value="250"/>
      </requirements>
      <requirements name="ANF-275" text="Maximale Höhe aller aerodynamischen Komponenten hinter der vordersten Fläche der Kopfstützenhalterung (ohne Polster) über dem Boden" subteam="Aerodynamik" category="Bauteilbegrenzung" unit="mm" priority="Muss" role="AERO">
        <carValues name="EV3" value="1200"/>
        <carValues name="CV2" value="1200"/>
        <carValues name="CV1" value="1200"/>
      </requirements>
      <requirements name="ANF-276" text="Maximale Höhe vom Boden für Aero-Elemente hinter der Vorderachse, die bis zur äußeren Radebene reichen dürfen" subteam="Aerodynamik" category="Bauteilbegrenzung" unit="mm" priority="Muss" role="AERO">
        <carValues name="EV3" value="500"/>
        <carValues name="CV2" value="500"/>
        <carValues name="CV1" value="500"/>
      </requirements>
      <requirements name="ANF-277" text="Minimale Höhe vom Boden für Aero-Elemente, die nicht über die innere Radebene der Hinterräder ragen dürfen" subteam="Aerodynamik" category="Bauteilbegrenzung" unit="mm" priority="Muss" role="AERO">
        <carValues name="EV3" value="500"/>
        <carValues name="CV2" value="500"/>
        <carValues name="CV1" value="500"/>
      </requirements>
      <requirements name="ANF-278" text="Maximale Länge der aerodynamischen Baueteile (Überhang hinten)" subteam="Aerodynamik" category="Bauteilbegrenzung" unit="mm" priority="Muss" role="AERO">
        <carValues name="EV3" value="250"/>
        <carValues name="CV2" value="250"/>
        <carValues name="CV1" value="250"/>
      </requirements>
      <requirements name="ANF-279" text="Maximale Länge der aerodynamischen Baueteile (Überhang vorne)" subteam="Aerodynamik" category="Bauteilbegrenzung" unit="mm" priority="Muss" role="AERO">
        <carValues name="EV3" value="700"/>
        <carValues name="CV2" value="700"/>
        <carValues name="CV1" value="700"/>
      </requirements>
      <requirements name="ANF-280" text="Maximale Auslenkung der aerodynamischen Bauteile (bei 200 N Last auf 225 cm²)" subteam="Aerodynamik" category="Bauteilstärke" unit="mm" priority="Muss" role="AERO">
        <carValues name="EV3" value="10"/>
        <carValues name="CV2" value="10"/>
        <carValues name="CV1" value="10"/>
      </requirements>
      <requirements name="ANF-281" text="Maximale Auslenkung der aerodynamischen Bauteile (bei 50 N Punktlast in beliebiger Richtung)" subteam="Aerodynamik" category="Bauteilstärke" unit="mm" priority="Muss" role="AERO">
        <carValues name="EV3" value="25"/>
        <carValues name="CV2" value="25"/>
        <carValues name="CV1" value="25"/>
      </requirements>
      <requirements name="ZIE-013" text="Anteil der statischen Belastung der erwarteten Last, die die Frontflügel-Befestigung ohne Schaden standhalten muss" subteam="Aerodynamik" category="-" unit="%" priority="Muss" role="AERO" kind="Goal">
        <carValues name="EV3" value="120"/>
      </requirements>
    </sections>
    <sections name="CRASHRequirements" description="Requirements realised by Crash Structure Engineer">
      <requirements name="ANF-166" text="Sämtliche Rückhaltesysteme müssen die SFI-Spezifikation 16.1, 16.5, 16.6 oder die FIA-Spezifikation 8853/2016 erfüllen" subteam="Monocoque" category="Fahrergurt" unit="-" priority="Muss" role="CRASH">
        <carValues name="EV3" value="x"/>
        <carValues name="CV2" value="x"/>
        <carValues name="CV1" value="x"/>
      </requirements>
      <requirements name="ANF-167" text="Die Gurte müssen mit den entsprechenden datierten Etiketten versehen sein" subteam="Monocoque" category="Fahrergurt" unit="-" priority="Muss" role="CRASH">
        <carValues name="EV3" value="x"/>
        <carValues name="CV2" value="x"/>
        <carValues name="CV1" value="x"/>
      </requirements>
      <requirements name="ANF-169" text="Es muss ein einziger Metall-auf-Metall-Schnellverschluss für alle Gurtbänder vorhanden sein" subteam="Monocoque" category="Fahrergurt" unit="-" priority="Muss" role="CRASH">
        <carValues name="EV3" value="x"/>
        <carValues name="CV2" value="x"/>
        <carValues name="CV1" value="x"/>
      </requirements>
      <requirements name="ANF-170" text="Alle Beckengurte müssen über einen Tilt-Lock-Einsteller (&quot;Quick Adjuster&quot;) verfügen" subteam="Monocoque" category="Fahrergurt" unit="-" priority="Muss" role="CRASH">
        <carValues name="EV3" value="x"/>
        <carValues name="CV2" value="x"/>
        <carValues name="CV1" value="x"/>
      </requirements>
      <requirements name="ANF-171" text="Der Schultergurt muss als &quot;Over-the-Shoulder&quot;-Typ ausgeführt sein, wobei nur separate Schultergurte zulässig sind (Y-Gurte sind verboten; H-Gurte sind erlaubt)" subteam="Monocoque" category="Fahrergurt" unit="-" priority="Muss" role="CRASH">
        <carValues name="EV3" value="x"/>
        <carValues name="CV2" value="x"/>
        <carValues name="CV1" value="x"/>
      </requirements>
      <requirements name="ANF-172" text="Das Gurtsystem muss jederzeit fest angelegt sein" subteam="Monocoque" category="Fahrergurt" unit="-" priority="Muss" role="CRASH">
        <carValues name="EV3" value="x"/>
        <carValues name="CV2" value="x"/>
        <carValues name="CV1" value="x"/>
      </requirements>
      <requirements name="ANF-173" text="Becken-, Schulter- und Anti-Submarine-Gurte müssen sicher an der Primärstruktur des Fahrzeugs befestigt sein" subteam="Monocoque" category="Fahrergurt" unit="-" priority="Muss" role="CRASH">
        <carValues name="EV3" value="x"/>
        <carValues name="CV2" value="x"/>
        <carValues name="CV1" value="x"/>
      </requirements>
      <requirements name="ANF-179" text="Gurtzeuge, Gurte und Riemen dürfen nicht durch eine Firewall geführt werden, was bedeutet, dass sich alle Befestigungspunkte des Gurtsystems auf der Fahrerseite jeder Firewall befinden müssen" subteam="Monocoque" category="Fahrergurt" unit="-" priority="Muss" role="CRASH">
        <carValues name="EV3" value="x"/>
        <carValues name="CV2" value="x"/>
        <carValues name="CV1" value="x"/>
      </requirements>
      <requirements name="ANF-180" text="Becken- und Anti-Submarine-Gurte dürfen nicht über die Seiten des Sitzes geführt werden" subteam="Monocoque" category="Fahrergurt" unit="-" priority="Muss" role="CRASH">
        <carValues name="EV3" value="x"/>
        <carValues name="CV2" value="x"/>
        <carValues name="CV1" value="x"/>
      </requirements>
      <requirements name="ANF-181" text="An Stellen, an denen Gurte durch eine Öffnung im Sitz führen, muss die Kante des Sitzes abgerundet oder mit einer Tülle versehen sein, um ein Aufscheuern der Gurte zu verhindern" subteam="Monocoque" category="Fahrergurt" unit="-" priority="Muss" role="CRASH">
        <carValues name="EV3" value="x"/>
        <carValues name="CV2" value="x"/>
        <carValues name="CV1" value="x"/>
      </requirements>
      <requirements name="FUN-013" text="Gurtlänge mechanisch an die Körpermaße des Fahrers anpassen" subteam="Monocoque" category="Fahrergurt" unit="-" priority="Muss" role="CRASH" kind="Function">
        <carValues name="EV3" value="x"/>
        <carValues name="CV2" value="x"/>
        <carValues name="CV1" value="x"/>
      </requirements>
      <requirements name="FUN-014" text="Alle Gurtbänder über einen zentralen Mechanismus zeitgleich freigeben" subteam="Monocoque" category="Fahrergurt" unit="-" priority="Muss" role="CRASH" kind="Function">
        <carValues name="EV3" value="x"/>
        <carValues name="CV2" value="x"/>
        <carValues name="CV1" value="x"/>
      </requirements>
      <requirements name="ANF-191" text="Maximaler Winkel der Schrittgurte nach hinten bei vertikaler Führung" subteam="Monocoque" category="Schrittgurt" unit="°" priority="Muss" role="CRASH">
        <carValues name="EV3" value="20"/>
        <carValues name="CV2" value="20"/>
        <carValues name="CV1" value="20"/>
      </requirements>
      <requirements name="ANF-192" text="Abstand der Verankerungspunkte bei vertikaler Führung der Schrittgurte" subteam="Monocoque" category="Schrittgurt" unit="mm" priority="Muss" role="CRASH">
        <carValues name="EV3" value="100"/>
        <carValues name="CV2" value="100"/>
        <carValues name="CV1" value="100"/>
      </requirements>
      <requirements name="ANF-140" text="Minimale Größe der metrischen 8,8-Festigkeitsklasse-Schrauben für eine Gurtbefestigung am Monocoque bei Verwendung einer einzelnen Schraube" subteam="Monocoque" category="Befestigung des Fahrergurts" unit="mm" priority="Muss" role="CRASH">
        <carValues name="EV3" value="10"/>
        <carValues name="CV2" value="10"/>
        <carValues name="CV1" value="10"/>
      </requirements>
      <requirements name="ANF-141" text="Minimale Größe der metrischen 8,8-Festigkeitsklasse-Schrauben für eine Gurtbefestigung am Monocoque bei Verwendung von zwei Schrauben" subteam="Monocoque" category="Befestigung des Fahrergurts" unit="mm" priority="Muss" role="CRASH">
        <carValues name="EV3" value="8"/>
        <carValues name="CV2" value="8"/>
        <carValues name="CV1" value="8"/>
      </requirements>
      <requirements name="ANF-142" text="Minimale Dicke der erforderlichen Stahl-Gegenplatten für die Gurtbefestigung am Monocoque" subteam="Monocoque" category="Befestigung des Fahrergurts" unit="mm" priority="Muss" role="CRASH">
        <carValues name="EV3" value="2"/>
        <carValues name="CV2" value="2"/>
        <carValues name="CV1" value="2"/>
      </requirements>
      <requirements name="ANF-145" text="Minimale Lastkapazität der Befestigungen für Schulter- und Beckengurte" subteam="Monocoque" category="Befestigung des Fahrergurts" unit="kN" priority="Muss" role="CRASH">
        <carValues name="EV3" value="13"/>
        <carValues name="CV2" value="13"/>
        <carValues name="CV1" value="13"/>
      </requirements>
      <requirements name="ANF-146" text="Minimale Lastkapazität der Befestigungspunkte für die Anti-Submarine-Gurte" subteam="Monocoque" category="Befestigung des Fahrergurts" unit="kN" priority="Muss" role="CRASH">
        <carValues name="EV3" value="6,5"/>
        <carValues name="CV2" value="6,5"/>
        <carValues name="CV1" value="6,5"/>
      </requirements>
      <requirements name="ANF-147" text="Minimale Gesamtlastkapazität der Befestigungen, wenn Becken- und Anti-Submarine-Gurte weniger als 100 mm voneinander entfernt angebracht sind" subteam="Monocoque" category="Befestigung des Fahrergurts" unit="kN" priority="Muss" role="CRASH">
        <carValues name="EV3" value="19,5"/>
        <carValues name="CV2" value="19,5"/>
        <carValues name="CV1" value="19,5"/>
      </requirements>
      <requirements name="ANF-174" text="Minimale Querschnittsfläche aus Stahl der Befestigungslasche oder des Halters, die bei Abscherung oder Zugversagen an einem beliebigen Punkt standhalten muss" subteam="Sicherheit" category="Fahrergurt" unit="mm²" priority="Muss" role="CRASH">
        <carValues name="CV1" value="60"/>
      </requirements>
      <requirements name="ANF-175" text="Minimale Dicke der Befestigungslasche oder des Halters" subteam="Sicherheit" category="Fahrergurt" unit="mm" priority="Muss" role="CRASH">
        <carValues name="CV1" value="1,6"/>
      </requirements>
      <requirements name="ANF-176" text="Minimale Querschnittsfläche aus Stahl, wenn Becken- und Anti-Submarine-Gurte denselben Befestigungspunkt nutzen" subteam="Sicherheit" category="Fahrergurt" unit="mm²" priority="Muss" role="CRASH">
        <carValues name="CV1" value="90"/>
      </requirements>
      <requirements name="ANF-177" text="Mindestanzahl der Befestigungselemente, wenn Halterungen am Chassis verschraubt werden" subteam="Sicherheit" category="Fahrergurt" unit="Anzahl" priority="Muss" role="CRASH">
        <carValues name="CV1" value="2"/>
      </requirements>
      <requirements name="ANF-178" text="Minimaler Durchmesser der Befestigungselemente bei Befestigung am Chassis (bei mindestens metrischer Festigkeitsklasse 8.8)" subteam="Sicherheit" category="Fahrergurt" unit="mm" priority="Muss" role="CRASH">
        <carValues name="CV1" value="6"/>
      </requirements>
      <requirements name="ANF-143" text="Minimale Anzahl der metrischen Schrauben der Festigkeitsklasse 8,8 oder höher für Gurtbefestigungen an der Primärstruktur mittels Halterungen" subteam="Monocoque" category="Befestigung des Fahrergurts" unit="Anzahl" priority="Muss" role="CRASH">
        <carValues name="EV3" value="2"/>
        <carValues name="CV2" value="2"/>
      </requirements>
      <requirements name="ANF-144" text="Minimaler Durchmesser der metrischen Schrauben der Festigkeitsklasse 8,8 oder höher für Gurtbefestigungen an der Primärstruktur mittels Halterungen" subteam="Monocoque" category="Befestigung des Fahrergurts" unit="mm" priority="Muss" role="CRASH">
        <carValues name="EV3" value="8"/>
        <carValues name="CV2" value="8"/>
      </requirements>
      <requirements name="ANF-148" text="Minimale Dicke von Stahlhalterungen oder -laschen für Gurtbefestigungen, unter der eine physische Prüfung erforderlich ist" subteam="Monocoque" category="Befestigung des Fahrergurts" unit="mm" priority="Muss" role="CRASH">
        <carValues name="EV3" value="1,6"/>
        <carValues name="CV2" value="1,6"/>
      </requirements>
      <requirements name="ANF-182" text="Der Beckengurt muss so angelegt sein, dass er den Beckenbereich unterhalb der vorderen oberen Darmbeinstacheln (den Hüftknochen) umschließt" subteam="Monocoque" category="Beckengurt" unit="-" priority="Muss" role="CRASH">
        <carValues name="EV3" value="x"/>
        <carValues name="CV2" value="x"/>
        <carValues name="CV1" value="x"/>
      </requirements>
      <requirements name="ANF-183" text="Die Beckengurte müssen am Boden der Sitzseiten durch den Sitz geführt werden, um die Umschließung der Beckenoberfläche zu maximieren und in einer geraden Linie zum Verankerungspunkt zu verlaufen" subteam="Monocoque" category="Beckengurt" unit="-" priority="Muss" role="CRASH">
        <carValues name="EV3" value="x"/>
        <carValues name="CV2" value="x"/>
        <carValues name="CV1" value="x"/>
      </requirements>
      <requirements name="ANF-185" text="In der Seitenansicht muss der Beckengurt durch die Verwendung einer Ansatzschraube oder einer Augenschraube frei schwenkbar sein" subteam="Monocoque" category="Beckengurt" unit="-" priority="Muss" role="CRASH">
        <carValues name="EV3" value="x"/>
