<requirements:RequirementsSpecification xmlns:xmi="http://www.omg.org/XMI" xmlns:requirements="http://vitruv.tools/methodologisttemplate/requirements" name="PRJ" description="Requirements specification of the KA-RaceIng product line (EV3, CV2, CV1)" xmi:version="2.0">
  <sections name="RuleSet" description="Requirements and decisions for RuleSet">
    <sections name="FS2019" description="Requirements and decisions for FS2019"/>
    <sections name="FS2025" description="Requirements and decisions for FS2025">
      <sections name="HydrogenClassRules" description="Requirements and decisions for HydrogenClassRules">
        <requirements name="ANF-923" text="Für die erste Implementierung darf ein bestehendes Verbrenner- oder Elektrofahrzeug auf Wasserstoff umgerüstet werden" subteam="Gesamtfahrzeug" category="Fahrzeugkonvertierung" unit="-" priority="Kann" role="PRJ">
          <carValues name="CV2" value="x"/>
        </requirements>
        <requirements name="ANF-924" text="Maximale Nutzungsdauer eines Wasserstofffahrzeugs ab dem ersten Wettbewerb" subteam="Gesamtfahrzeug" category="Fahrzeugnutzungsdauer" unit="Jahre" priority="Kann" role="PRJ">
          <carValues name="CV2" value="x"/>
        </requirements>
        <requirements name="ANF-926" text="Maximaler nominaler Arbeitsdruck des bereitgestellten Wasserstoffs" subteam="Wasserstoff Antriebsstrang" category="Kraftstoff" unit="bar" priority="Muss" role="PRJ">
          <carValues name="CV2" value="x"/>
        </requirements>
        <requirements name="ANF-927" text="Kryogener, flüssiger oder kryo-komprimierter Wasserstoff ist verboten" subteam="Wasserstoff Antriebsstrang" category="Kraftstoff" unit="-" priority="Muss" role="PRJ">
          <carValues name="CV2" value="x"/>
        </requirements>
        <requirements name="ANF-991" text="Derzeit keine Leistungsbegrenzung für H2CV/H2HY Antriebsstränge" subteam="Wasserstoff Antriebsstrang" category="Leistungsbegrenzung" unit="-" priority="-" role="PRJ">
          <carValues name="CV2" value="x"/>
        </requirements>
        <requirements name="ANF-992" text="Der Wasserstoff-Massenstrom ist unbegrenzt" subteam="Wasserstoff Antriebsstrang" category="Leistungsbegrenzung" unit="-" priority="-" role="PRJ">
          <carValues name="CV2" value="x"/>
        </requirements>
        <requirements name="ANF-993" text="Der Luft-Massenstrom ist unbegrenzt" subteam="Wasserstoff Antriebsstrang" category="Leistungsbegrenzung" unit="-" priority="-" role="PRJ">
          <carValues name="CV2" value="x"/>
        </requirements>
        <requirements name="ANF-994" text="Maximale gesamte Tankkapazität für H2CV/H2HY" subteam="Wasserstoff Antriebsstrang" category="Leistungsbegrenzung" unit="kg" priority="Muss" role="PRJ">
          <carValues name="CV2" value="x"/>
        </requirements>
      </sections>
    </sections>
  </sections>
  <sections name="CompetitionClasses" description="Requirements and decisions for CompetitionClasses">
    <sections name="Powertrain" description="Requirements and decisions for Powertrain">
