    <sections name="DESRequirements" description="Requirements realised by Design Engineer">
      <requirements name="ANF-003" text="Sperrbereich vor und hinter dem Außendurchmesser der Reifen" subteam="Gesamtfahrzeug" category="Fahrzeugmaße" unit="mm" priority="Muss" role="DES">
        <carValues name="EV3" value="75"/>
        <carValues name="CV2" value="75"/>
        <carValues name="CV1" value="75"/>
      </requirements>
      <requirements name="ANF-004" text="Minimale statische Bodenfreiheit aller Fahrzeugteile inklusive Fahrer" subteam="Gesamtfahrzeug" category="Fahrzeugmaße" unit="mm" priority="Muss" role="DES">
        <carValues name="EV3" value="30"/>
        <carValues name="CV2" value="30"/>
        <carValues name="CV1" value="30"/>
      </requirements>
      <requirements name="ANF-486" text="Das Fahrzeug muss für den autonomen Modus mit einem Autonomen Bremssystem ausgestattet sein, das ein Notbremssystem beinhaltet" subteam="Autonomes System" category="Autonomes Bremssystem Allgemein" unit="-" priority="Muss" role="DES">
        <carValues name="EV3" value="x"/>
      </requirements>
      <requirements name="ANF-487" text="Alle Teile des Autonomen Bremssystems und deren Halterungen müssen sich innerhalb der Überrollschutzhülle befinden (mit definierten Ausnahmen)" subteam="Autonomes System" category="Autonomes Bremssystem Montage" unit="-" priority="Muss" role="DES">
        <carValues name="EV3" value="x"/>
      </requirements>
      <requirements name="ANF-489" text="Manuelles Bremsen muss immer möglich sein" subteam="Autonomes System" category="Autonomes Bremssystem Funktion" unit="-" priority="Muss" role="DES">
        <carValues name="EV3" value="x"/>
      </requirements>
      <requirements name="ANF-490" text="Bei gleichzeitigem manuellen und autonomen Bremsen muss immer der höhere Druck auf die Bremsen wirken" subteam="Autonomes System" category="Autonomes Bremssystem Funktion" unit="-" priority="Muss" role="DES">
        <carValues name="EV3" value="x"/>
      </requirements>
      <requirements name="ANF-491" text="Hauptbremszylinder dürfen nicht in Reihe geschaltet sein" subteam="Autonomes System" category="Autonomes Bremssystem Design" unit="-" priority="Muss" role="DES">
        <carValues name="EV3" value="x"/>
      </requirements>
      <requirements name="FUN-045" text="Bei paralleler Betätigung den jeweils höheren Bremsdruck (manuell oder autonom) anwenden" subteam="Autonomes System" category="Autonomes Bremssystem Funktion" unit="-" priority="Muss" role="DES" kind="Function">
        <carValues name="EV3" value="x"/>
      </requirements>
      <requirements name="ANF-493" text="Das Autonome Bremssystem muss durch zwei Deaktivierungspunkte einfach deaktiviert werden können" subteam="Autonomes System" category="Deaktivierung" unit="Anzahl" priority="Muss" role="DES">
        <carValues name="EV3" value="2"/>
      </requirements>
      <requirements name="ANF-494" text="Deaktivierungspunkte müssen ohne elektrische Hilfsenergie funktionieren" subteam="Autonomes System" category="Deaktivierung" unit="-" priority="Muss" role="DES">
        <carValues name="EV3" value="x"/>
      </requirements>
      <requirements name="ANF-495" text="Die Deaktivierungspunkte müssen sich in unmittelbarer Nähe zueinander befinden" subteam="Autonomes System" category="Deaktivierung" unit="-" priority="Muss" role="DES">
        <carValues name="EV3" value="x"/>
      </requirements>
      <requirements name="ANF-496" text="Die Deaktivierungspunkte müssen innerhalb der Oberflächenhülle montiert sein" subteam="Autonomes System" category="Deaktivierung" unit="-" priority="Muss" role="DES">
        <carValues name="EV3" value="x"/>
      </requirements>
      <requirements name="ANF-498" text="Die Punkte müssen gegen unbeabsichtigte Betätigung während der Fahrt geschützt sein" subteam="Autonomes System" category="Deaktivierung" unit="-" priority="Muss" role="DES">
        <carValues name="EV3" value="x"/>
      </requirements>
      <requirements name="ANF-499" text="Maximale Anzahl an einfachen Drück-, Zieh- oder Drehbewegungen zur Betätigung" subteam="Autonomes System" category="Deaktivierung" unit="Anzahl" priority="Muss" role="DES">
        <carValues name="EV3" value="2"/>
      </requirements>
      <requirements name="ANF-500" text="Reihenfolge und Richtung der Betätigungsschritte müssen neben den Punkten angezeigt werden" subteam="Autonomes System" category="Deaktivierung" unit="-" priority="Muss" role="DES">
        <carValues name="EV3" value="x"/>
      </requirements>
      <requirements name="ANF-501" text="Die Punkte müssen mit &quot;Brake release&quot; gekennzeichnet sein" subteam="Autonomes System" category="Deaktivierung" unit="-" priority="Muss" role="DES">
        <carValues name="EV3" value="x"/>
      </requirements>
      <requirements name="ANF-502" text="Der Griff muss rot sein" subteam="Autonomes System" category="Deaktivierung" unit="-" priority="Muss" role="DES">
        <carValues name="EV3" value="x"/>
      </requirements>
      <requirements name="ANF-503" text="Die Verwendung von Push-in-Fittings ist in funktionskritischen pneumatischen Schaltkreisen des ASB und in allen Systemen am selben Energiespeicher ohne ordnungsgemäße Entkopplung verboten" subteam="Autonomes System" category="Deaktivierung" unit="-" priority="Muss" role="DES">
        <carValues name="EV3" value="x"/>
      </requirements>
      <requirements name="FUN-046" text="Das Autonome Bremssystem durch Betätigung der Deaktivierungspunkte entspannen/lösen" subteam="Autonomes System" category="Deaktivierung" unit="-" priority="Muss" role="DES" kind="Function">
        <carValues name="EV3" value="x"/>
      </requirements>
      <requirements name="ANF-497" text="Montageort muss entweder in der Nähe des AS-Hauptschalters oder auf der Fahrzeugoberseite zwischen den Schottwänden nahe der Mittellinie sein" subteam="Autonomes System" category="Deaktivierung" unit="-" priority="Muss" role="DES">
        <carValues name="EV3" value="x"/>
