        <carValues name="CV1" value="x"/>
      </requirements>
      <requirements name="ANF-087" text="Die Löcher in den Hülsen und Rohren müssen eine enge Passung (close-fit) mit den Bolzen aufweisen" subteam="Monocoque" category="Mechanisch befestigte Überrollbügel-Abstützung" unit="-" priority="Muss" role="CRASH">
        <carValues name="CV1" value="x"/>
