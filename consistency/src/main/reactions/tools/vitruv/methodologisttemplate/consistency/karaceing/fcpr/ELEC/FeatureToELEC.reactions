routine createElementInDevice(uvl::Feature feature, elec::Device container) {
    match{
        require absence of elec::Pin corresponding to feature
    }
    update{
        val containedClasses = EMFUtil.findContainedClasses(container.eClass())
        System.out.println("Contained classes: " + containedClasses)


        val componentType = userInteractor.singleSelectionDialogBuilder.message(
            "What element of the ELEC electrical design model do you want to add below " + EMFUtil.getNameOf(container) + " to be correspondent to the feature " + feature.name + "?").choices(
            EMFUtil.getAllNamesOfEClass(containedClasses)).windowModality(WindowModality.MODAL).
            startInteraction

        System.out.println("Selected element type index: " + componentType)

        switch (EMFUtil.getAllNamesOfEClass(containedClasses).get(componentType)) {
            case "Pin":
                createPinInDevice(feature, container)
            default:
                return // do nothing
        }
    }
}

routine createPinInDevice(uvl::Feature feature, elec::Device container) {
    create {
        val newElement = new elec::Pin
    }
    update {
        System.out.println("Adding Pin for feature " + feature.name + " to the ELEC electrical design model")
        newElement.name = feature.name
        container.pins.add(newElement);
        addCorrespondenceBetween(feature, newElement);
    }
}
