import java.io.File;
import tools.vitruv.methodologisttemplate.consistency.FeatureTreeUtil;
import UVLPackage.Feature;

import "http://vitruv.tools/methodologisttemplate/uvl" as uvl
import "http://www.example.org/cad" as cad


reactions: featureRoot2cad
in reaction to changes in uvl
execute actions in cad

reaction UVLDomainRootInserted{
    after element uvl::Feature inserted in uvl::Group[feature]
    with FeatureTreeUtil.isRootFeature(newValue.eContainer().eContainer()) && newValue.name == "DomainOneRoot"
    call createCADForDomainRoot(newValue)
}




routine createCADForDomainRoot(uvl::Feature feature) {
    match{
        require absence of cad::CAD_Model corresponding to feature
    }
    create{
        val cadModel = new cad::CAD_Model
    }
    update{
        System.out.println("Adding CAD model for domain root feature " + feature.name)
        persistProjectRelative(feature, cadModel, new File("").toString() + "brake.cad")
        addCorrespondenceBetween(feature, cadModel)
    }
}



