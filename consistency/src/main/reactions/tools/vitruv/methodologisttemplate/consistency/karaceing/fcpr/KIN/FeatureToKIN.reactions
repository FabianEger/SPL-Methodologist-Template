                createRevolutionInAssembly(feature, container)
            case "BooleanOperation":
                createBooleanOperationInAssembly(feature, container)
            default:
                return // do nothing
        }
    }
}

routine createAssemblyInAssembly(uvl::Feature feature, cad::Assembly container) {
    create {
        val newElement = new cad::Assembly
    }
    update {
        System.out.println("Adding Assembly for feature " + feature.name + " to the KIN CAD model")
        newElement.name = feature.name
        container.children.add(newElement);
        addCorrespondenceBetween(feature, newElement);
    }
}

