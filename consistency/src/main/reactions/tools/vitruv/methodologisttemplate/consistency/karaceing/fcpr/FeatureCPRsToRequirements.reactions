import "http://vitruv.tools/methodologisttemplate/uvl" as uvl
import "http://vitruv.tools/methodologisttemplate/requirements" as req

// Vitruvius allows only one change propagation specification per pair of metamodels (uvl -> requirements), so the
// Feature CPRs of all roles whose artefacts are requirements models (PRJ) and the feature removal are combined
// here, like CombinedUVLToCAD combines feature2cad and featureRoot2cad.

reactions: featureCPRsToRequirements
in reaction to changes in uvl
execute actions in req


import featureToPRJ using qualified names

import rootFeatureToPRJ using qualified names

import featureRemovalToRequirements using qualified names

