<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="electrical" nsURI="http://vitruv.tools/methodologisttemplate/electrical" nsPrefix="electrical">
  <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
    <details key="documentation" value="Electrical Design Model of the Electrical Engineer (ELEC): circuits, devices, pins, wires and buses."/>
  </eAnnotations>
  <eClassifiers xsi:type="ecore:EClass" name="ElectricalDesign">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Root element."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="elements" upperBound="-1" eType="#//ElectricalElement" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ElectricalElement" abstract="true">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Anything in the electrical design."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="description" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="partNumber" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Circuit" eSuperTypes="#//ElectricalElement">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A circuit or sub-system, e.g. the shutdown circuit."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="elements" upperBound="-1" eType="#//ElectricalElement" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="nominalVoltage" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="voltageClass" eType="#//VoltageClass"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Device" eSuperTypes="#//ElectricalElement">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="An electrical or electronic component. mountingPosition: the CAD element the device is mounted on (e.g. a caliper bracket)."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="kind" eType="#//DeviceKind"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="ratedVoltage" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="ratedCurrent" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="pins" upperBound="-1" eType="#//Pin" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="mountingPosition" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Pin">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A connector pin of a device."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="signal" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Wire" eSuperTypes="#//ElectricalElement">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A wire between two pins."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="source" eType="#//Pin"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="target" eType="#//Pin"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="crossSection" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Bus" eSuperTypes="#//ElectricalElement">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A communication bus (CAN, Ethernet)."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="protocol" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="nodes" upperBound="-1" eType="#//Device"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="VoltageClass">
    <eLiterals name="LV"/>
    <eLiterals name="HV" value="1"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="DeviceKind">
    <eLiterals name="Other"/>
    <eLiterals name="Switch" value="1"/>
    <eLiterals name="Relay" value="2"/>
    <eLiterals name="Sensor" value="3"/>
    <eLiterals name="Actuator" value="4"/>
    <eLiterals name="Fuse" value="5"/>
    <eLiterals name="Battery" value="6"/>
    <eLiterals name="ControlUnit" value="7"/>
    <eLiterals name="Indicator" value="8"/>
    <eLiterals name="Connector" value="9"/>
    <eLiterals name="Motor" value="10"/>
    <eLiterals name="Inverter" value="11"/>
    <eLiterals name="Valve" value="12"/>
  </eClassifiers>
</ecore:EPackage>
